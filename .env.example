# Copiá este archivo como .env y completá los valores

# Token del bot (Discord Developer Portal > tu aplicación > Bot > Reset Token)
DISCORD_TOKEN=
# ID de tu servidor: con esto los comandos aparecen al instante (sin esto tardan hasta 1 h)
DISCORD_GUILD_ID=
# ID del canal donde publicar ofertas de juegos populares (opcional)
DISCORD_CHANNEL_ID=
# Descuento mínimo para publicar en el canal y top de populares/deseados a considerar
DISCORD_MIN_DISCOUNT=50
DISCORD_TOP_RANK=100

# Mercado de la web por defecto y del bot
LOCALE=es-AR
REFRESH_HOURS=6
# Minutos mínimos entre actualizaciones manuales desde la web
REFRESH_COOLDOWN_MIN=30
# Máximo de juegos que puede seguir cada usuario de Discord
DISCORD_MAX_FOLLOWS=50
# Poner en 1 si la app está detrás de un proxy o túnel (Cloudflare, Fly, Railway…)
TRUST_PROXY=

# Key de la Web API de Steam (https://steamcommunity.com/dev/apikey): empareja todos los juegos en minutos
STEAM_API_KEY=
# Repo de GitHub para el botón "Reportar comparación incorrecta" (en GitHub Actions se completa solo)
REPORT_REPO=

# Steam: tipo de dólar de dolarapi.com para convertir USD a pesos (oficial, tarjeta, blue, mep)
STEAM_DOLLAR=oficial
# Búsquedas por nombre por actualización (para juegos que no aparecen en la lista completa de Steam)
STEAM_MATCHES_PER_RUN=150
